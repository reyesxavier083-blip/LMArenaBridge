# LEYRA IA — plantilla de configuración
# Copia este archivo como .env, pero NO subas .env a GitHub.
# El gateway actual lee variables de entorno; esta plantilla por sí sola no se carga.

LEYRA_UPSTREAM_BASE_URL=https://api.openai.com/v1
LEYRA_UPSTREAM_API_KEY=
LEYRA_GATEWAY_TOKEN=
LEYRA_UPSTREAM_TIMEOUT_SECONDS=90

# Agent Skills (project skills require explicit trust)
LEYRA_TRUST_PROJECT_SKILLS=false
# Optional additional skill roots, separated by the platform path separator
# LEYRA_SKILLS_PATHS=
