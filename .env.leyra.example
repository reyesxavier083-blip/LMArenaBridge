# Copy to .env.leyra locally. Never commit real credentials.
LEYRA_CONTROL_TOKEN=replace-with-a-long-random-secret
LEYRA_GATEWAY_TOKEN=replace-with-a-different-random-secret
LEYRA_UPSTREAM_BASE_URL=https://api.openai.com/v1
LEYRA_UPSTREAM_API_KEY=replace-with-your-provider-api-key
LEYRA_UPSTREAM_TIMEOUT_SECONDS=90
