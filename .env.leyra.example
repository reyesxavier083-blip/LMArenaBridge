LEYRA_ENV=production
LEYRA_CONTROL_TOKEN=replace-with-a-long-random-control-secret
LEYRA_GATEWAY_TOKEN=replace-with-a-different-client-secret
LEYRA_UPSTREAM_BASE_URL=https://api.openai.com/v1
LEYRA_UPSTREAM_API_KEY=add-provider-key-in-secret-manager
LEYRA_UPSTREAM_TIMEOUT_SECONDS=90
LEYRA_EMBEDDING_MODEL=text-embedding-3-small
LEYRA_POSTGRES_PASSWORD=replace-with-a-long-random-database-password
LEYRA_DATABASE_URL=postgresql://leyra:change-me@postgres:5432/leyra
LEYRA_REDIS_URL=redis://redis:6379/0
LEYRA_JWT_SECRET=replace-with-64-random-characters
LEYRA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LEYRA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-16-character-password
