FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LEYRA_ENV=production \
    LEYRA_DATABASE_PATH=/data/leyra.sqlite3

WORKDIR /app
COPY requirements-leyra.txt ./requirements-leyra.txt
RUN pip install --no-cache-dir -r requirements-leyra.txt
COPY src ./src

RUN useradd --create-home --uid 10001 leyra \
    && mkdir -p /data \
    && chown -R leyra:leyra /app /data
USER leyra

EXPOSE 8000
CMD ["uvicorn", "src.leyra.app:app", "--host", "0.0.0.0", "--port", "8000"]
